# Required application secrets (generate separate random values for each)
PAYLOAD_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-different-long-random-secret

# Local PostgreSQL (matches docker-compose.yml)
POSTGRES_DB=nutriscan
POSTGRES_USER=nutriscan
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://nutriscan:change-this-local-password@localhost:5432/nutriscan

# Public origin of this Next.js server
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Required for AI food analysis and chat; keep server-side only
APP_GROQ_API_KEY=

# Optional Google OAuth (email/password authentication works without it)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional persistent object storage. If omitted, Payload stores files in ./media.
# Configure all four required values to enable AWS S3 or an S3-compatible service.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers; leave blank for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
